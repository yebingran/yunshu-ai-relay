# Replace the domain with your own HTTPS origin, without a trailing slash/path.
PUBLIC_ORIGIN=https://ai.example.com
# Paste independently generated values from three executions of openssl rand -hex 32.
# Use hexadecimal values so passwords do not need URL encoding in SQL_DSN/Redis URL.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
SESSION_SECRET=
# This network must already exist and include the 1Panel OpenResty container.
ONEPANEL_NETWORK=1panel-network
# Use docker network inspect to find this network's real Subnet; do not use 0.0.0.0/0.
TRUSTED_PROXIES=
# This absolute host directory is retained across container updates.
DATA_ROOT=/opt/yunsuguanai
# latest for convenient updates, or sha-<full Git commit> for a pinned release.
IMAGE_TAG=latest
